{
  "name": "sillytavern-mcp-client",
  "version": "0.1.0",
  "description": "MCP Client plugin for SillyTavern — Tools, Resources, Prompts with multimodal support",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:server": "tsup",
    "build:extension": "vite build --config extension/vite.config.ts",
    "build": "npm run build:server && npm run build:extension"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  }
}
